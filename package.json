{
  "name": "new-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "vercel-build": "next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "clean:artifacts": "node scripts/clean-local-artifacts.mjs",
    "verify": "npm run verify:repo-hygiene && npm run verify:home-boundary && npm run verify:route-contract && npm run verify:docs",
    "verify:corridor": "node scripts/verify-corridor.mjs",
    "verify:home-boundary": "node scripts/verify-home-boundary.mjs",
    "verify:motion-showcase": "node scripts/verify-motion-showcase.mjs",
    "verify:repo-hygiene": "node scripts/verify-repo-hygiene.mjs",
    "verify:route-contract": "node scripts/verify-route-contract.mjs",
    "verify:route-smoke": "node scripts/verify-route-smoke.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:deploy-input": "node scripts/verify-deploy-input.mjs",
    "verify:deploy": "npm run clean:artifacts && npm run build && npm run verify && npm run verify:corridor && npm run verify:deploy-input && npm run verify:route-smoke",
    "lint": "next lint",
    "process:fabrics": "python3 scripts/process_fabric_images.py --apply --rename-only",
    "process:fabrics:dry": "python3 scripts/process_fabric_images.py --rename-only"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^171.4.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.20",
    "lucide-react": "^0.475.0",
    "next": "15.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
